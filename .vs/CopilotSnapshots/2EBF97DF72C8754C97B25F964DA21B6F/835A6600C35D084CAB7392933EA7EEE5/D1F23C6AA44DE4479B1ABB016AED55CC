import React, { useEffect, useState } from 'react';
import useAuthStore from '../store/authStore';
import { getProfile, clock as apiClock } from '../api/api';
import useFetch from '../utils/useFetch';

export default function EmployeeDashboard() {
  const { accessToken, user } = useAuthStore();
  const [profile, setProfile] = useState(null);
  const [message, setMessage] = useState('');

  useEffect(() => {
	let mounted = true;
	if (!accessToken) return;
	getProfile(accessToken).then(res => { if (mounted && res.success) setProfile(res.data); }).catch(()=>{});
	return () => { mounted = false; };
  }, [accessToken]);

  async function handleClock() {
	try {
	  const res = await apiClock(accessToken);
	  if (res.success) setMessage(res.message || 'Success');
	  else setMessage(res.message || 'Action failed');
	} catch (err) {
	  setMessage(err.message);
	}

  async function handleUpload(e) {
	const files = e.target.files;
	if (!files || files.length === 0) return;
	const fd = new FormData();
	for (const f of files) fd.append('files', f);
	try {
	  const res = await fetch('/api/employee/documents', { method: 'POST', headers: { Authorization: `Bearer ${accessToken}` }, body: fd });
	  const json = await res.json();
	  if (json.success) {
		setProfile(json.data);
		setMessage('Files uploaded');
	  } else setMessage(json.message || 'Upload failed');
	} catch (err) { setMessage(err.message); }
  }
  }

  return (
	<div className="p-6">
	  <h2 className="text-2xl font-bold">Employee Dashboard</h2>
	  <div className="mt-4">
		<p>Welcome {user?.email} ({user?.employeeId})</p>
		<button onClick={handleClock} className="mt-2 px-4 py-2 bg-blue-600 text-white rounded">Clock In / Out</button>
		{message && <div className="mt-2 text-sm text-green-700">{message}</div>}
	  </div>

	  <div className="mt-6">
		<h3 className="font-semibold">Profile</h3>
		{profile ? (
		  <div>
			<p>{profile.firstName} {profile.lastName}</p>
			<p>Phone: {profile.phone || '—'}</p>
			<p>Department: {profile.department || '—'}</p>
			<p>Leave Balance: {JSON.stringify(profile.leaveBalance || {})}</p>
			  <div className="mt-3">
			  <label className="block mb-1">Upload Documents</label>
			  <input type="file" multiple onChange={handleUpload} />
			</div>
		  </div>
		) : <p>Loading...</p>}
	  </div>
	</div>
  );
}
